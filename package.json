{
  "name": "typoscope",
  "version": "0.1.0",
  "description": "Typoscope is a local-first TypeScript CLI that audits npm package.json dependencies for suspicious packages — typosquatting lookalikes,.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "typoscope": "./src/index.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node --check src/index.js",
    "test": "node --test",
    "smoke": "node src/index.js --help && npm run package:smoke",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm test && npm run build && npm run smoke"
  },
  "keywords": [],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/typoscope.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/typoscope/issues"
  },
  "homepage": "https://github.com/rogerchappel/typoscope#readme"
}
