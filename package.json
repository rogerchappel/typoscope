{
  "name": "@rogerchappel/typoscope",
  "version": "0.1.0",
  "description": "Local-first npm dependency risk scanner for typosquatting, lifecycle scripts, and suspicious package metadata.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "typoscope": "./src/index.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node --check src/index.js",
    "test": "node --test",
    "smoke": "node src/index.js --help && npm run package:smoke",
    "package:name-check": "node scripts/check-package-name.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "lockfile:check": "npm install --package-lock-only --ignore-scripts && git diff --exit-code -- package-lock.json && npm ci --ignore-scripts",
    "release:check": "npm run package:name-check && npm test && npm run build && npm run smoke"
  },
  "keywords": [
    "npm",
    "dependencies",
    "typosquatting",
    "supply-chain",
    "security"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/typoscope.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/typoscope/issues"
  },
  "homepage": "https://github.com/rogerchappel/typoscope#readme"
}
